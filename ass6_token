import java.util.*;

public class TokenRing {

    static boolean[] alive;
    static int n;

    // Find next active process
    static int nextActive(int current) {

        int next = (current + 1) % n;

        while (!alive[next]) {
            next = (next + 1) % n;
        }

        return next;
    }

    // Election Function
    static void election(int start) {

        System.out.println("\nElection started from P" + start);

        int current = start;
        int max = start;

        while (true) {

            int next = nextActive(current);

            // Token passing
            System.out.println("P" + current +
                    " -> P" + next);

            // Find highest active process
            if (current > max) {
                max = current;
            }

            current = next;

            // Ring completed
            if (current == start) {
                break;
            }
        }

        // Coordinator elected
        System.out.println("\nCoordinator (Ring Leader) = P" + max);

        // Coordinator message circulation
        System.out.println("\nCoordinator Messages:");

        current = max;

        while (true) {

            int next = nextActive(current);

            System.out.println("P" + current +
                    " => P" + next);

            current = next;

            if (current == max) {
                break;
            }
        }
    }

    // Show Status
    static void showStatus() {

        System.out.println("\nProcess Status:");

        for (int i = 0; i < n; i++) {

            System.out.println("P" + i + " : "
                    + (alive[i] ? "UP" : "DOWN"));
        }
    }

    public static void main(String[] args) {
        System.out.println("jello");

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter total number of processes: ");

        n = sc.nextInt();

        alive = new boolean[n];

        Arrays.fill(alive, true);

        while (true) {

            System.out.println("\n========= MENU =========");
            System.out.println("1. UP a process");
            System.out.println("2. DOWN a process");
            System.out.println("3. ELECT leader");
            System.out.println("4. SHOW STATUS");
            System.out.println("5. EXIT");

            System.out.print("Enter your choice: ");

            int choice = sc.nextInt();

            switch (choice) {

                case 1:

                    System.out.print("Process to UP (0-"
                            + (n - 1) + "): ");

                    int up = sc.nextInt();

                    alive[up] = true;

                    System.out.println("P" + up + " is now UP");

                    break;

                case 2:

                    System.out.print("Process to DOWN (0-"
                            + (n - 1) + "): ");

                    int down = sc.nextInt();

                    alive[down] = false;

                    System.out.println("P" + down + " is now DOWN");

                    break;

                case 3:

                    System.out.print("Start election from process (0-"
                            + (n - 1) + "): ");

                    int start = sc.nextInt();

                    if (!alive[start]) {

                        System.out.println("Process is DOWN");

                    } else {

                        election(start);
                    }

                    break;

                case 4:

                    showStatus();

                    break;

                case 5:

                    System.out.println("Exiting...");

                    System.exit(0);

                default:

                    System.out.println("Invalid choice");
            }
        }
    }
}
